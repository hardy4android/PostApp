# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

# Resolve Play Store JSON key:
#   • On CI  → written by the workflow to android/play-service-account.json
#   • Locally → absolute path on the dev machine
LOCAL_JSON_KEY  = "/Users/pinalramoliya/Documents/HARDIK_MACBOOK/Projects/HVN/NanoBanana/Doc/play-service-account.json"
CI_JSON_KEY     = File.expand_path("../play-service-account.json", __dir__)   # android/play-service-account.json
PLAY_JSON_KEY   = File.exist?(CI_JSON_KEY) ? CI_JSON_KEY : LOCAL_JSON_KEY

platform :android do

  desc "Deploy to Google Play (Internal Testing)"
  lane :deploy_internal do
    gradle(
      task: "bundleRelease",
      print_command: true,
      print_command_output: true,
      properties: {
        "org.gradle.caching" => "true"
      },
      flags: "--stacktrace --info --build-cache --no-parallel"
    )

    upload_to_play_store(
      track: "internal",
      json_key: PLAY_JSON_KEY,
      package_name: "com.postapp.ai",
      aab: "../app/build/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Deploy to Production (20% rollout)"
  lane :deploy_production do
    gradle(
      task: "clean bundleRelease"
    )

    upload_to_play_store(
      track: "production",
      json_key: PLAY_JSON_KEY,
      package_name: "com.postapp.ai",
      aab: "../app/build/outputs/bundle/release/app-release.aab",
      rollout: 0.2
    )
  end

end
