{
  "name": "PostApp",
  "main": "expo-router/entry",
  "version": "0.2.4",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android-release": "expo run:android --variant release",
    "clean-android": "cd android && ./gradlew clean && cd ..",
    "release-apk": "cd android && ./gradlew assembleRelease && cd ..",
    "release-bundle": "cd android && ./gradlew bundleRelease && cd ..",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "plugins-compile": "tsc ./plugins/${FILENAME}.ts --skipLibCheck",
    "prettier:write": "prettier src --write",
    "prettier:check": "prettier src --check",
    "ts:check": "tsc",
    "validate": "bun lint && bun prettier:check && bun ts:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo-google-fonts/courgette": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo-google-fonts/lora": "^0.2.3",
    "@expo-google-fonts/poppins": "^0.2.3",
    "@react-native-firebase/analytics": "^22.2.1",
    "@react-native-firebase/app": "^22.2.1",
    "@react-native-firebase/firestore": "^22.2.1",
    "@react-native-ml-kit/face-detection": "^2.0.1",
    "@sentry/react-native": "~6.14.0",
    "expo": "^53.0.12",
    "expo-application": "~6.1.4",
    "expo-asset": "~11.1.7",
    "expo-build-properties": "~0.14.6",
    "expo-constants": "~17.1.6",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.1",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.1",
    "expo-image": "~2.3.0",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.5",
    "expo-localization": "^17.0.8",
    "expo-router": "~5.1.0",
    "expo-secure-store": "~14.2.3",
    "expo-splash-screen": "~0.30.9",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "expo-web-browser": "~14.2.0",
    "lottie-react-native": "^7.3.5",
    "luxon": "^3.6.1",
    "moti": "^0.30.0",
    "query-string": "7.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.4",
    "react-native-gesture-handler": "^2.27.2",
    "react-native-iap": "14.7.20",
    "react-native-mmkv": "^3.3.0",
    "react-native-nitro-modules": "0.35.3",
    "react-native-reanimated": "^3.10.1",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-share": "^12.2.6",
    "react-native-svg": "^15.12.1",
    "twrnc": "^4.9.0",
    "zustand": "^5.0.5",
    "zx": "^8.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/luxon": "^3.6.2",
    "@types/react": "~19.0.10",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "eslint": "^9.26.0",
    "eslint-config-expo": "~9.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3"
  },
  "private": true,
  "trustedDependencies": [
    "@sentry/cli",
    "protobufjs",
    "unrs-resolver"
  ]
